+/**
+ * `syncMethod` des graphes liés dont chacun a ses lignes (lot 164) : Recharts
+ * synchronise d'ordinaire par numéro de ligne, ici par abscisse. Rend la place
+ * dans `ticks` de la graduation la plus proche de l'abscisse du graphe survolé
+ * (`activeLabel`), la première à égalité ; sans abscisse numérique, le numéro
+ * de ligne reçu.
+ */
+export const syncNearestTick = (
+  ticks: ReadonlyArray<{ value?: unknown }>,
+  data: { activeLabel?: unknown; activeTooltipIndex?: unknown }
+): number => {
+  const label = data.activeLabel;
+  const target = typeof label === 'number' ? label : typeof label === 'string' && label !== '' ? Number(label) : NaN;
+  if (Number.isNaN(target)) return typeof data.activeTooltipIndex === 'number' ? data.activeTooltipIndex : -1;
+  let best = -1;
+  let bestGap = Infinity;
+  ticks.forEach((tick, k) => {
+    const gap = Math.abs(Number(tick.value) - target);
+    if (gap < bestGap) {
+      bestGap = gap;
+      best = k;
+    }
+  });
+  return best;
+};
+
 /** Vrai si l'abscisse `value` du point survolé est dans la plage zoomée (ou s'il n'y a pas de zoom) : sinon, rien à lire. */
 export const inChartView = (view: XRange | null, value: number): boolean => !view || (value >= view.min && value <= view.max);
 
