# Modèle de android/keystore.properties (ce dernier n'est jamais versionné : voir .gitignore).
# Copier ce fichier en keystore.properties et remplir les quatre valeurs.
# Lu par android/app/build.gradle ; sans keystore.properties, la version de diffusion n'est pas signée.
# Création de la clé : voir docs/DEVELOPPER.md (keytool).
#
# Chemin du fichier .jks, relatif à android/app/ ou absolu.
storeFile=../../chemin/vers/ma-cle.jks
storePassword=
keyAlias=
keyPassword=
